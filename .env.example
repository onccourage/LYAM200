# Скопируйте в .env и заполните. .env не коммитится.
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE=https://api.anthropic.com
LLM_PROVIDER=anthropic            # anthropic | openai_compatible
LLM_MODEL=claude-sonnet-5-5       # дешёвый режим: claude-haiku-5-5
LLM_BASE_URL=                     # для openai_compatible (vLLM/Ollama), напр. http://localhost:8001/v1
LLM_API_KEY=                      # ключ для openai_compatible (если нужен)
LLM_EFFORT=medium                 # low | medium | high — глубина рассуждений модели
LLM_MAX_TOKENS=16000
LLM_SAMPLES=1                     # >1 — консенсус: N проходов модели, по каждому критерию ответ большинства
LLM_SAMPLE_TEMPERATURE=0.7        # температура доп. проходов для OpenAI-совместимых (у Claude не используется)
LLM_SERVER_FALLBACK=auto          # auto | on | off — серверный fallback при отказе классификатора безопасности
LLM_TIMEOUT_SEC=300
LLM_MAX_RETRIES=4                 # SDK сам повторяет 429/5xx с экспоненциальной задержкой

# API организаторов (group_id подставляется из UI, тот, что в ссылке, заменяется)
DATASET_API_URL=https://ec88f21f1accecf38e20095a9fe175.a5.environment.api.powerplatform.com/powerautomate/automations/direct/cu/11/workflows/b3d2a68006a24662be2b721454cb4e00/triggers/manual/paths/invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=5Sog2MThgCRTlk3HObv70LRmRk6u7IOwzlwMpe804qo
DEFAULT_GROUP_ID=DEV
DATASET_TIMEOUT_SEC=30

EXPLANATION_LANG=ru               # язык объяснений модели
LONG_PAUSE_SEC=120                # пауза клиент→оператор, после которой ждём предупреждения
BATCH_CONCURRENCY=5               # параллельных диалогов в пакетной оценке
BATCH_RETRIES=2                   # повторы диалога, если модель недоступна (поверх ретраев SDK)
BATCH_RETRY_BASE_SEC=5            # экспоненциальная задержка: 5, 10, 20 с

# Цены за 1 млн токенов (USD). claude-sonnet-5-5: 2 / 10; claude-haiku-5-5: 0.10 / 0.50
PRICE_INPUT_PER_MTOK=2
PRICE_OUTPUT_PER_MTOK=10
PRICE_CACHE_WRITE_MULT=1.25       # запись в кэш промпта = 1.25 × цена входа
PRICE_CACHE_READ_MULT=0.1         # чтение из кэша = 0.1 × цена входа

DB_PATH=data/cqa.db
SEED_ON_START=0                   # 1 — при пустой БД загрузить готовые оценки из data/seed (демо без API; в UI помечаются «из сида»)

# --- Альтернатива: Google Gemini через OpenAI-совместимый endpoint (без правки кода) ---
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.5-flash        # алиас gemini-flash-latest на проверке зависал — указывайте версию явно
# LLM_API_KEY=                      # ключ из Google AI Studio
# PRICE_INPUT_PER_MTOK=0            # бесплатный уровень; для платного — цены из прайса Google
# PRICE_OUTPUT_PER_MTOK=0
# BATCH_CONCURRENCY=2               # у бесплатного уровня низкие лимиты запросов в минуту
